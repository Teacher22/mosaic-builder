{
  "name": "Mosaic Builder",
  "short_name": "Mosaic",
  "description": "Rebuild any image from your own photos. Everything stays on your device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#17142B",
